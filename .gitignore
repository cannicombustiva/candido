.DS_Store
.build/
.swiftpm/
DerivedData/
# Generated by xcodegen from project.yml — project.yml is the source of truth
Candido.xcodeproj/
*.xcuserstate
xcuserdata/
*.xcworkspace/xcshareddata/IDEWorkspaceChecks.plist

# Real application data. The JSON backup mirror holds company names, titles and
# private notes; this repo is public. Never let an export be committed, wherever
# the backup folder happens to point.
candido-backup*.json
jobtracker-backup*.json
/*.json
!/skills-lock.json

# Credentials. Nothing in the app reads a .env — this guards the agent skills,
# which do: a wizard generated from .agents/skills/wizard writes the keys it
# captures straight to one. Same reason as the backups above, and the same
# stakes: this repo is public.
.env
.env.*
!.env.example

# Scratch space for local-markdown notes and throwaway prototypes
.scratch/

# Release packaging artifacts (the release workflow builds these at the repo root)
staging/
*.dmg
